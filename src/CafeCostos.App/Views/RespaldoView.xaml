<UserControl x:Class="CafeCostos.App.Views.RespaldoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Titulo}" Style="{StaticResource TituloPantalla}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ CREAR COPIA ============ -->
            <StackPanel>
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Crear copia de seguridad" Style="{StaticResource TituloTarjeta}" />
                        <TextBlock TextWrapping="Wrap" FontSize="15">
                            Guarda TODA la información del negocio (lotes, costos, ventas, cartera y configuración) en un solo archivo con fecha y hora.
                        </TextBlock>
                        <Button Style="{StaticResource BotonGrande}" Command="{Binding CrearCommand}" Margin="0,18,0,0" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Iconos}" Text="&#xE74E;" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Crear copia de seguridad ahora" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CrearEnCommand}" Margin="0,10,0,0" HorizontalAlignment="Stretch" MinHeight="54">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Iconos}" Text="&#xE88E;" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Guardar copia en memoria USB u otra carpeta…" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding Progreso}" Foreground="{StaticResource AcentoOscuro}" FontWeight="SemiBold" Margin="0,12,0,0"
                                   Visibility="{Binding Progreso, Converter={StaticResource TextoVis}}" />

                        <TextBlock Text="Carpeta de copias" Style="{StaticResource Etiqueta}" Margin="0,18,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Cambiar…" Command="{Binding CambiarCarpetaCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding Carpeta, Mode=OneWay}" IsReadOnly="True" />
                        </DockPanel>
                        <CheckBox Content="Crear una copia automática diaria al cerrar el programa" IsChecked="{Binding Automatico}" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding MotorInfo}" Style="{StaticResource Ayuda}" Margin="0,10,0,0" />
                        <Border Style="{StaticResource CajaAviso}">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Aviso}">
                                Recomendación: al menos una vez por semana guarde una copia en una memoria USB y llévela fuera del local.
                                Si el computador se daña o se pierde, con esa copia recupera todo.
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Estado de la base de datos" Style="{StaticResource TituloTarjeta}" />
                        <DataGrid ItemsSource="{Binding Almacenamiento}" MaxHeight="230" RowHeight="30" FontSize="13">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tabla" Binding="{Binding Tabla}" Width="*" />
                                <DataGridTextColumn Header="Compresión" Binding="{Binding Compresion}" />
                                <DataGridTextColumn Header="Filas" Binding="{Binding Filas, StringFormat=N0}" ElementStyle="{StaticResource CeldaDerecha}" />
                                <DataGridTextColumn Header="MB" Binding="{Binding TamanoMB, StringFormat=N2}" ElementStyle="{StaticResource CeldaDerecha}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Content="Optimizar ahora" Command="{Binding MantenimientoCommand}" Margin="0" />
                            <TextBlock VerticalAlignment="Center"><Run Text="Tamaño total: " /><Run Text="{Binding TamanoTotalMB, StringFormat={}{0:N2} MB, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                        </DockPanel>
                        <TextBlock Text="La optimización se ejecuta sola una vez por semana al cerrar el programa." Style="{StaticResource Ayuda}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ RESTAURAR (ASISTENTE) ============ -->
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
                <Grid>
                    <!-- Paso 0: lista de copias -->
                    <DockPanel Visibility="{Binding EnAsistente, Converter={StaticResource BoolVisInv}}">
                        <TextBlock DockPanel.Dock="Top" Text="Restaurar una copia de seguridad" Style="{StaticResource TituloTarjeta}" />
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12">
                            Paso 1: seleccione una copia de la lista o busque el archivo (por ejemplo, en la memoria USB).
                        </TextBlock>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Restaurar la copia seleccionada" Style="{StaticResource BotonPrimario}" Command="{Binding RestaurarSeleccionadoCommand}" />
                            <Button Content="Buscar archivo…" Command="{Binding ElegirArchivoCommand}" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Respaldos}" SelectedItem="{Binding Seleccionado}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=g}" />
                                <DataGridTextColumn Header="Archivo" Binding="{Binding Nombre}" Width="*" />
                                <DataGridTextColumn Header="Tamaño" Binding="{Binding Tamano}" ElementStyle="{StaticResource CeldaDerecha}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Paso 1: verificando archivo -->
                    <StackPanel Visibility="{Binding PasoRestauracion, Converter={StaticResource PasoVis}, ConverterParameter=1}" VerticalAlignment="Center">
                        <TextBlock Text="Verificando el archivo…" Style="{StaticResource TituloTarjeta}" HorizontalAlignment="Center" />
                        <ProgressBar IsIndeterminate="True" Width="260" Height="6" />
                    </StackPanel>

                    <!-- Paso 2: confirmar -->
                    <StackPanel Visibility="{Binding PasoRestauracion, Converter={StaticResource PasoVis}, ConverterParameter=2}">
                        <TextBlock Text="Paso 2: confirme la restauración" Style="{StaticResource TituloTarjeta}" />
                        <Border Style="{StaticResource Resaltado}">
                            <StackPanel>
                                <TextBlock Text="Archivo" Foreground="{StaticResource TextoSuave}" />
                                <TextBlock Text="{Binding ArchivoRestaurar}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="Información guardada el" Foreground="{StaticResource TextoSuave}" Margin="0,10,0,0" />
                                <TextBlock Style="{StaticResource ValorMedio}">
                                    <TextBlock.Text>
                                        <Binding Path="InfoArchivo.FechaCopia" StringFormat="{}{0:dddd d 'de' MMMM 'de' yyyy, HH:mm}" />
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Exito}" Text="✔ El archivo es una copia válida de CaféCostos y pasó la verificación de integridad." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CajaAviso}" Background="{StaticResource PeligroClaro}">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Peligro}">
                                Todo lo registrado DESPUÉS de esa fecha se reemplazará. Antes de restaurar, el programa guardará automáticamente una copia de la información actual.
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding Progreso}" Foreground="{StaticResource AcentoOscuro}" FontWeight="SemiBold" Margin="0,12,0,0"
                                   Visibility="{Binding Progreso, Converter={StaticResource TextoVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Restaurar ahora" Style="{StaticResource BotonPrimario}" Command="{Binding ConfirmarRestauracionCommand}" />
                            <Button Content="Cancelar" Command="{Binding CancelarRestauracionCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Paso 3: terminado -->
                    <StackPanel Visibility="{Binding PasoRestauracion, Converter={StaticResource PasoVis}, ConverterParameter=3}">
                        <TextBlock Text="Paso 3: restauración terminada" Style="{StaticResource TituloTarjeta}" Foreground="{StaticResource Exito}" />
                        <TextBlock Text="{Binding ResultadoRestauracion}" TextWrapping="Wrap" FontSize="15" />
                        <TextBlock Text="Ya puede seguir trabajando normalmente." Margin="0,12,0,0" />
                        <Button Content="Volver" Command="{Binding CancelarRestauracionCommand}" Margin="0,18,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
