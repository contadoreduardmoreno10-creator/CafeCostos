<UserControl x:Class="CafeCostos.App.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Titulo}" Style="{StaticResource TituloPantalla}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Tarjeta}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Nuevo cliente" Style="{StaticResource BotonPrimario}" Command="{Binding NuevoCommand}" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Buscar" Command="{Binding BuscarCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding Filtro}" ToolTip="Buscar por nombre o documento" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Clientes}" SelectedItem="{Binding Seleccionado}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                            <DataGridTextColumn Header="Documento" Binding="{Binding Documento}" />
                            <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" />
                            <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" />
                            <DataGridTextColumn Header="Plazo" Binding="{Binding DiasCredito, StringFormat={}{0} días}" />
                            <DataGridTextColumn Header="Cupo" Binding="{Binding CupoCredito, StringFormat=C0, TargetNullValue=Sin límite}" ElementStyle="{StaticResource CeldaDerecha}" />
                            <DataGridTextColumn Header="Saldo" Binding="{Binding SaldoPendiente, StringFormat=C0}" ElementStyle="{StaticResource CeldaDerecha}" />
                            <DataGridTextColumn Header="Vencido" Binding="{Binding SaldoVencido, StringFormat=C0}" ElementStyle="{StaticResource CeldaDerecha}" Foreground="#B3261E" />
                            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource TituloTarjeta}" />
                        <TextBlock Text="Nombre o razón social *" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding Edicion.Nombre}" />
                        <TextBlock Text="NIT / Cédula" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding Edicion.Documento}" IsEnabled="{Binding Edicion.EsGenerico, Converter={StaticResource Neg}}" />
                        <TextBlock Text="Teléfono / WhatsApp" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding Edicion.Telefono}" />
                        <TextBlock Text="Dirección" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding Edicion.Direccion}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Ciudad" Style="{StaticResource Etiqueta}" />
                                <TextBox Text="{Binding Edicion.Ciudad}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Correo" Style="{StaticResource Etiqueta}" />
                                <TextBox Text="{Binding Edicion.Email}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Condiciones de crédito" FontWeight="SemiBold" FontSize="15" Margin="0,18,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Plazo (días)" Style="{StaticResource Etiqueta}" />
                                <TextBox Text="{Binding Edicion.DiasCredito, Converter={StaticResource Num}}" Style="{StaticResource Numero}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cupo máximo ($)" Style="{StaticResource Etiqueta}" />
                                <TextBox Text="{Binding Edicion.CupoCredito, Converter={StaticResource Pesos}}" Style="{StaticResource Numero}"
                                         IsEnabled="{Binding SinLimite, Converter={StaticResource Neg}}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Crédito sin límite de cupo" IsChecked="{Binding SinLimite}" />
                        <TextBlock Text="Cupo $0 = el cliente solo compra de contado." Style="{StaticResource Ayuda}" />
                        <CheckBox Content="Cliente activo" IsChecked="{Binding Edicion.Activo}" />

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Guardar" Style="{StaticResource BotonPrimario}" Command="{Binding GuardarCommand}" MinWidth="140" />
                            <Button Content="Nuevo" Command="{Binding NuevoCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
