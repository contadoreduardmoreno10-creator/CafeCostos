<UserControl x:Class="CafeCostos.App.Views.PresentacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Titulo}" Style="{StaticResource TituloPantalla}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- ============ LISTA ============ -->
            <Border Style="{StaticResource Tarjeta}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Nueva presentación" Command="{Binding NuevoCommand}" Margin="0" />
                        <TextBlock Text="Presentaciones" Style="{StaticResource TituloTarjeta}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Presentaciones}" SelectedItem="{Binding Seleccionada}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                            <DataGridTextColumn Header="Gramos" Binding="{Binding GramosNetos}" ElementStyle="{StaticResource CeldaDerecha}" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoMolienda}" />
                            <DataGridTextColumn Header="Precio" Binding="{Binding PrecioVenta, StringFormat=C0}" ElementStyle="{StaticResource CeldaDerecha}" />
                            <DataGridCheckBoxColumn Header="Activa" Binding="{Binding Activo}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ============ EDICIÓN + RECETA ============ -->
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Datos de la presentación" Style="{StaticResource TituloTarjeta}" />
                        <TextBlock Text="Nombre comercial *" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding Edicion.Nombre}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Contenido neto (gramos) *" Style="{StaticResource Etiqueta}" />
                                <TextBox Text="{Binding Edicion.GramosNetos, Converter={StaticResource Num}}" Style="{StaticResource Numero}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Grano o molido *" Style="{StaticResource Etiqueta}" />
                                <ComboBox ItemsSource="{Binding TiposMolienda}" SelectedItem="{Binding Edicion.TipoMolienda}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Grado de molienda (si es molido)" Style="{StaticResource Etiqueta}" />
                        <ComboBox ItemsSource="{Binding GradosMolienda}" Text="{Binding Edicion.GradoMolienda}" IsEditable="True" />
                        <TextBlock Text="Precio de venta al público ($)" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding Edicion.PrecioVenta, Converter={StaticResource Pesos}}" Style="{StaticResource Numero}" FontSize="18" FontWeight="SemiBold" />
                        <CheckBox Content="Presentación activa" IsChecked="{Binding Edicion.Activo}" />

                        <TextBlock Text="Insumos por cada bolsa (receta)" FontWeight="SemiBold" FontSize="15" Margin="0,20,0,4" />
                        <DataGrid ItemsSource="{Binding Receta}" IsReadOnly="False" MaxHeight="220" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Insumo" Binding="{Binding Nombre, Mode=OneWay}" IsReadOnly="True" Width="*" />
                                <DataGridTextColumn Header="Cant. por bolsa" Binding="{Binding Cantidad, Converter={StaticResource Num}}" ElementStyle="{StaticResource CeldaDerecha}" />
                                <DataGridTemplateColumn>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource BotonIcono}" Content="&#xE74D;" ToolTip="Quitar"
                                                    Command="{Binding DataContext.QuitarInsumoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Agregar" Command="{Binding AgregarInsumoCommand}" Margin="8,0,0,0" />
                            <TextBox DockPanel.Dock="Right" Width="70" Text="{Binding CantidadInsumo, Converter={StaticResource Num}}" Style="{StaticResource Numero}" Margin="8,0,0,0" />
                            <ComboBox ItemsSource="{Binding InsumosDisponibles}" SelectedItem="{Binding InsumoElegido}" DisplayMemberPath="Nombre" />
                        </DockPanel>

                        <Button Content="Guardar presentación" Style="{StaticResource BotonPrimario}" Command="{Binding GuardarCommand}" Margin="0,20,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============ SIMULADOR DE PRECIO ============ -->
            <Border Grid.Column="2" Style="{StaticResource Tarjeta}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Simulador de costo y precio" Style="{StaticResource TituloTarjeta}" />
                        <TextBlock Text="Estima cuánto cuesta producir una bolsa hoy y qué precio deja el margen deseado." Style="{StaticResource Ayuda}" />
                        <TextBlock Text="Costo actual del kg tostado ($)" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding CostoKgTostado, Converter={StaticResource Pesos}}" Style="{StaticResource Numero}" />
                        <TextBlock Text="Promedio del café tostado disponible (o última tostión)." Style="{StaticResource Ayuda}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Merma molienda %" Style="{StaticResource Etiqueta}" />
                                <TextBox Text="{Binding MermaMolienda, Converter={StaticResource Num}}" Style="{StaticResource Numero}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Margen objetivo %" Style="{StaticResource Etiqueta}" />
                                <TextBox Text="{Binding MargenObjetivo, Converter={StaticResource Num}}" Style="{StaticResource Numero}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Conversión por bolsa ($)" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding ConversionUnidad, Converter={StaticResource Pesos}}" Style="{StaticResource Numero}" />
                        <Button Content="Calcular" Command="{Binding SimularCommand}" Margin="0,14,0,0" HorizontalAlignment="Stretch" />
                        <TextBlock Text="Guarde primero la presentación para simular." Style="{StaticResource Ayuda}" />

                        <Border Style="{StaticResource Resaltado}" Visibility="{Binding Estimacion, Converter={StaticResource NuloVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Text="Café" />
                                <TextBlock Grid.Column="1" Text="{Binding Estimacion.CostoCafe, StringFormat={}{0:C0}}" />
                                <TextBlock Grid.Row="1" Text="Insumos" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Estimacion.CostoInsumos, StringFormat={}{0:C0}}" />
                                <TextBlock Grid.Row="2" Text="Conversión" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Estimacion.CostoConversion, StringFormat={}{0:C0}}" />
                                <TextBlock Grid.Row="3" Text="Costo por bolsa" FontWeight="Bold" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Estimacion.CostoTotal, StringFormat={}{0:C0}}" FontWeight="Bold" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="4" Text="Margen con el precio actual" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Estimacion.MargenPct, StringFormat={}{0:N1} %}" Margin="0,10,0,0" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="5" Text="Utilidad por bolsa" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Estimacion.UtilidadBruta, StringFormat={}{0:C0}}" FontWeight="SemiBold" />
                                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                    <TextBlock Text="PRECIO SUGERIDO" Foreground="{StaticResource AcentoOscuro}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Estimacion.PrecioSugerido, StringFormat={}{0:C0}}" Style="{StaticResource ValorGrande}" Foreground="{StaticResource AcentoOscuro}" />
                                    <Button Content="Usar este precio" Command="{Binding UsarPrecioSugeridoCommand}" Margin="0,8,0,0" HorizontalAlignment="Left" MinHeight="36" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
