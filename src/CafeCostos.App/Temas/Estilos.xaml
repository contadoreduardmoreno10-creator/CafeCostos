<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:CafeCostos.App.Converters">

    <!-- =====================  PALETA (tostado / crema)  ===================== -->
    <Color x:Key="CFondo">#F6F1EB</Color>
    <Color x:Key="CAcento">#A0522D</Color>
    <SolidColorBrush x:Key="Fondo" Color="#F6F1EB" />
    <SolidColorBrush x:Key="Superficie" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuperficieSuave" Color="#FBF8F4" />
    <SolidColorBrush x:Key="Barra" Color="#2F2119" />
    <SolidColorBrush x:Key="BarraHover" Color="#45322A" />
    <SolidColorBrush x:Key="BarraActiva" Color="#5C4033" />
    <SolidColorBrush x:Key="BarraTexto" Color="#E9DCCF" />
    <SolidColorBrush x:Key="Acento" Color="#A0522D" />
    <SolidColorBrush x:Key="AcentoOscuro" Color="#7A3E22" />
    <SolidColorBrush x:Key="AcentoClaro" Color="#F3E3D6" />
    <SolidColorBrush x:Key="Exito" Color="#2E7D32" />
    <SolidColorBrush x:Key="ExitoClaro" Color="#E6F2E7" />
    <SolidColorBrush x:Key="Peligro" Color="#B3261E" />
    <SolidColorBrush x:Key="PeligroClaro" Color="#FBE9E7" />
    <SolidColorBrush x:Key="Aviso" Color="#8A5300" />
    <SolidColorBrush x:Key="AvisoClaro" Color="#FFF4E0" />
    <SolidColorBrush x:Key="Texto" Color="#2A211C" />
    <SolidColorBrush x:Key="TextoSuave" Color="#7A6E66" />
    <SolidColorBrush x:Key="Borde" Color="#E2D8CE" />

    <FontFamily x:Key="Iconos">Segoe MDL2 Assets</FontFamily>

    <!-- =====================  CONVERTIDORES  ===================== -->
    <c:PesosConverter x:Key="Pesos" />
    <c:NumeroConverter x:Key="Num" />
    <c:BoolVisibilidadConverter x:Key="BoolVis" />
    <c:BoolVisibilidadConverter x:Key="BoolVisInv" Invertir="True" />
    <c:NuloVisibilidadConverter x:Key="NuloVis" />
    <c:NuloVisibilidadConverter x:Key="NuloVisInv" Invertir="True" />
    <c:IgualVisibilidadConverter x:Key="PasoVis" />
    <c:TextoVacioVisibilidadConverter x:Key="TextoVis" />
    <c:NegarConverter x:Key="Neg" />

    <!-- =====================  TEXTOS  ===================== -->
    <Style x:Key="TituloPantalla" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="TituloTarjeta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="Etiqueta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
        <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style x:Key="Ayuda" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="ValorGrande" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
    </Style>
    <Style x:Key="ValorMedio" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
    </Style>

    <!-- =====================  CONTENEDORES  ===================== -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Superficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,16,16" />
    </Style>
    <Style x:Key="Resaltado" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AcentoClaro}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <Style x:Key="CajaAviso" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AvisoClaro}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style x:Key="Kpi" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
        <Setter Property="MinWidth" Value="210" />
        <Setter Property="Padding" Value="18,16" />
    </Style>

    <!-- =====================  BOTONES  ===================== -->
    <Style x:Key="BotonBase" TargetType="Button">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="MinWidth" Value="46" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{StaticResource Superficie}" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.72" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AcentoOscuro}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BotonBase}" />
    <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource Acento}" />
        <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="BotonGrande" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="28,12" />
    </Style>
    <Style x:Key="BotonExito" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource Exito}" />
        <Setter Property="BorderBrush" Value="{StaticResource Exito}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Foreground" Value="{StaticResource Peligro}" />
        <Setter Property="BorderBrush" Value="{StaticResource Peligro}" />
    </Style>
    <Style x:Key="BotonIcono" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="FontFamily" Value="{StaticResource Iconos}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Peligro}" />
    </Style>

    <!-- Botón del menú lateral -->
    <Style x:Key="BotonMenu" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BarraTexto}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Margin="10,2" Padding="14,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource BarraHover}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Activo}" Value="True">
                <Setter Property="Background" Value="{StaticResource BarraActiva}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Selector tipo "segmento" (Contado / Crédito) -->
    <Style x:Key="Segmento" TargetType="RadioButton">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borde}" BorderThickness="1"
                            CornerRadius="8" Padding="18,10" Margin="0,0,8,0" MinHeight="46">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Acento}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Acento}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =====================  ENTRADAS  ===================== -->
    <Style TargetType="TextBox">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
        <Setter Property="Background" Value="{StaticResource SuperficieSuave}" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
                <Setter Property="Background" Value="White" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{StaticResource Fondo}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Peligro}" />
                <Setter Property="ToolTip" Value="Valor no válido. Escriba solo números." />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Numero" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectedDateFormat" Value="Short" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <!-- =====================  TABLAS  ===================== -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Borde}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SuperficieSuave}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="38" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Fondo}" />
        <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AcentoClaro}" />
                <Setter Property="Foreground" Value="{StaticResource Texto}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Filas anuladas en gris tachado -->
    <Style x:Key="FilaConEstado" TargetType="DataGridRow">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Estado}" Value="ANULADO">
                <Setter Property="Foreground" Value="#A39A93" />
                <Setter Property="FontStyle" Value="Italic" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Estado}" Value="ANULADA">
                <Setter Property="Foreground" Value="#A39A93" />
                <Setter Property="FontStyle" Value="Italic" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Anulado}" Value="True">
                <Setter Property="Foreground" Value="#A39A93" />
                <Setter Property="FontStyle" Value="Italic" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CeldaDerecha" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- Barra de progreso indeterminada para operaciones largas -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{StaticResource Acento}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
</ResourceDictionary>
